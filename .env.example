# LandGov AI - National Land Governance Research & Policy Innovation Platform
# Environment Configuration

# Database: SQLite by default for zero-setup local demo; or PostgreSQL with pgvector for production
# SQLite example:
DATABASE_URL=sqlite:///./landgov.db
# PostgreSQL with pgvector example (Docker Compose):
# DATABASE_URL=postgresql://landgov:landgov_secure_password_2026@localhost:5432/landgov
# POSTGRES_DB=landgov
# POSTGRES_USER=landgov
# POSTGRES_PASSWORD=landgov_secure_password_2026

# Security & JWT
JWT_SECRET=national-land-governance-ai-platform-secret-key-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Provider Configuration (Optional: Gemini or OpenAI)
# If left empty, platform automatically runs high-fidelity local semantic search and analytical synthesis
GEMINI_API_KEY=
OPENAI_API_KEY=

# Platform Environment
DEMO_MODE=true
ENVIRONMENT=development
UPLOAD_DIR=./uploads
DATA_DIR=./data
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
